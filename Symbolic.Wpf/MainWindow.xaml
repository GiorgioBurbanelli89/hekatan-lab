                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="∫" FontSize="26"/><Run Text="0" BaselineAlignment="Subscript" FontSize="10"/><Run Text="1" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" x"/><Run Text="2" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" dx = "/><Run Text="⅓" FontSize="19"/><LineBreak/><Run Text="Cambia @(x) y los límites 0, 1." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="Integral doble  ∬" Click="Button_Click"
                                          Tag="f = @(x, y) x.*y;§ax = 0; bx = 1; ay = 0; by = 1;§I2 = integral2(f, ax, bx, ay, by)">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="∬" FontSize="26"/><Run Text=" x·y dx dy = "/><Run Text="¼" FontSize="19"/><Run Text="   (sobre [0,1]²)"/><LineBreak/><Run Text="integral2(@(x,y) f, xmin, xmax, ymin, ymax)" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="Integral triple  ∭" Click="Button_Click"
                                          Tag="f = @(x, y, z) x.*y.*z;§I3 = integral3(f, 0, 1, 0, 1, 0, 1)">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="∭" FontSize="26"/><Run Text=" x·y·z dV = "/><Run Text="⅛" FontSize="19"/><Run Text="   (sobre [0,1]³)"/><LineBreak/><Run Text="integral3(@(x,y,z) f, x0,x1, y0,y1, z0,z1)" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="Integral de datos (trapz)" Click="Button_Click"
                                          Tag="x = linspace(0, 1, 100);§y = x.^2;§area = trapz(x, y)">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="∫"  FontSize="26"/><Run Text=" f(x) dx  ≈  "/><Run Text="Σ" FontSize="20"/><Run Text=" ½(y"/><Run Text="i" BaselineAlignment="Subscript" FontSize="10"/><Run Text="+y"/><Run Text="i+1" BaselineAlignment="Subscript" FontSize="10"/><Run Text=")Δx"/><LineBreak/><Run Text="Integra datos muestreados (x, y). Sin fórmula." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="Integral con bucle (trapecio)" Click="Button_Click"
                                          Tag="a = 0; b = 1; n = 100;§h = (b - a)/n;§s = 0;§for k = 1:n§    x0 = a + (k-1)*h;§    x1 = a + k*h;§    s = s + 0.5*h*(x0^2 + x1^2);§end§s">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="∫" FontSize="26"/><Run Text="0" BaselineAlignment="Subscript" FontSize="10"/><Run Text="1" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" x"/><Run Text="2" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" dx = "/><Run Text="⅓" FontSize="19"/><Run Text="   (a mano, con for)"/><LineBreak/><Run Text="La MISMA integral con un bucle (trapecio)." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="Integral de Gauss (gaussint)" Click="Button_Click"
                                          Tag="syms x§I_g = gaussint(x^2, x, 0, 1)">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="∫" FontSize="26"/><Run Text="0" BaselineAlignment="Subscript" FontSize="10"/><Run Text="1" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" x"/><Run Text="2" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" dx = "/><Run Text="⅓" FontSize="19"/><Run Text="   (Gauss-Legendre)"/><LineBreak/><Run Text="Cuadratura de Gauss: gaussint(expr, x, a, b, n). Sin disp ni fprintf." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="── Sumas / productos ──" IsEnabled="False"/>
                                <MenuItem Header="Suma  Σ  (vectorizada)" Click="Button_Click"
                                          Tag="s = sum((1:100).^2)">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="Σ" FontSize="26"/><Run Text="k=1" BaselineAlignment="Subscript" FontSize="10"/><Run Text="100" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" k"/><Run Text="2" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" = 338350"/><LineBreak/><Run Text="En una línea, vectorizada (MKL)." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="Suma  Σ  con bucle" Click="Button_Click"
                                          Tag="s = 0;§for k = 1:100§    s = s + k^2;§end§s">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="Σ" FontSize="26"/><Run Text="k=1" BaselineAlignment="Subscript" FontSize="10"/><Run Text="100" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" k"/><Run Text="2" BaselineAlignment="Superscript" FontSize="10"/><Run Text="   (con for)"/><LineBreak/><Run Text="La misma Σ con un bucle. Más didáctica." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="Producto  Π" Click="Button_Click"
                                          Tag="p = prod(1:5)">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="Π" FontSize="26"/><Run Text="k=1" BaselineAlignment="Subscript" FontSize="10"/><Run Text="5" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" k = 5! = 120"/><LineBreak/><Run Text="prod multiplica los elementos." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="── Derivadas / raíces ──" IsEnabled="False"/>
                                <MenuItem Header="Derivada numérica (gradient)" Click="Button_Click"
                                          Tag="x = linspace(0, 2*pi, 100);§y = sin(x);§dydx = gradient(y, x);§plot(x, dydx)">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="d" FontStyle="Italic"/><Run Text="y"/><Run Text=" / "/><Run Text="d" FontStyle="Italic"/><Run Text="x  ≈  cos(x)"/><Run Text="   (de sin x)"/><LineBreak/><Run Text="Derivada aproximada de datos: gradient(y, x)." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="Diferencias (diff)" Click="Button_Click"
                                          Tag="v = [1 4 9 16];§d = diff(v)">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="Δv"/><Run Text="i" BaselineAlignment="Subscript" FontSize="10"/><Run Text=" = v"/><Run Text="i+1" BaselineAlignment="Subscript" FontSize="10"/><Run Text=" − v"/><Run Text="i" BaselineAlignment="Subscript" FontSize="10"/><Run Text="   →  [3  5  7]"/><LineBreak/><Run Text="Diferencias consecutivas (derivada discreta)." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                                <MenuItem Header="Raíz de ecuación (fzero)" Click="Button_Click"
                                          Tag="f = @(x) x^2 - 2;§x0 = 1;§r = fzero(f, x0)">
                                    <MenuItem.ToolTip>
                                        <ToolTip Style="{StaticResource MathTip}"><TextBlock FontSize="16"><Run Text="x"/><Run Text="2" BaselineAlignment="Superscript" FontSize="10"/><Run Text=" − 2 = 0   →   x = √2 ≈ 1.414"/><LineBreak/><Run Text="Resuelve f(x) = 0 cerca de un punto inicial." FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"/></TextBlock></ToolTip>
                                    </MenuItem.ToolTip>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- Desplegable de operaciones SIMBÓLICAS (lo que Calcpad NO tiene). Todas verificadas.
                         Renderizan como math (d/dx, ∫, factorización…). -->
                    <Button Grid.Row="0" Style="{StaticResource FormatButton}" Margin="712,0,0,0"
                        x:Name="SymMenuButton" Width="46" FontSize="10" FontFamily="Roboto"
                        Click="DispMenuButton_Click" Content="symb▾"
                        ToolTip="Cálculo simbólico (syms): derivadas, integrales, límites, factorizar, resolver, sustituir, Taylor, jacobiano, LaTeX. (En MATLAB requiere el Symbolic Toolbox de pago.)">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SymTemplatesMenu" Style="{StaticResource ThemedContextMenu}">
                                <MenuItem Header="Declarar variable  (syms)" Click="Button_Click"
                                          Tag="%' Declarar x como variable simbólica:§syms x"
                                          ToolTip="Declara x como variable simbólica. Necesario antes de derivar, integrar, resolver, etc. Varias: syms x y z"/>
                                <MenuItem Header="── Cálculo ──" IsEnabled="False"/>
                                <MenuItem Header="Derivada  ∂" Click="Button_Click"
                                          Tag="%' Derivada de f(x) = x³ + 2x respecto a x:§syms x§f(x) = x^3 + 2*x§df = diff(f(x), x)"
                                          ToolTip="Derivada simbólica ∂f/∂x. Ejemplo: ∂(x³+2x)/∂x = 3x²+2. Cambia f."/>
                                <MenuItem Header="Integral indefinida  ∫" Click="Button_Click"
                                          Tag="%' Integral indefinida de f(x) = x²:§syms x§f(x) = x^2§F = int(f(x), x)"
                                          ToolTip="Integral simbólica (antiderivada). Ejemplo: ∫x² dx = x³/3."/>
                                <MenuItem Header="Integral definida  ∫ₐᵇ" Click="Button_Click"
                                          Tag="%' Integral definida de f(x) = x² entre 0 y 1:§syms x§f(x) = x^2§I = int(f(x), x, 0, 1)"
                                          ToolTip="Integral simbólica entre límites. Ejemplo: ∫₀¹ x² dx = 1/3 (exacto, como fracción)."/>
                                <MenuItem Header="Límite  lim" Click="Button_Click"
                                          Tag="%' Límite de f(x) = sin(x)/x cuando x → 0:§syms x§f(x) = sin(x)/x§L = limit(f(x), x, 0)"
                                          ToolTip="Límite simbólico. Ejemplo: lim(x→0) sin(x)/x = 1."/>
                                <MenuItem Header="Serie de Taylor" Click="Button_Click"
                                          Tag="%' Serie de Taylor de f(x) = eˣ alrededor de x = 0:§syms x§f(x) = exp(x)§T = taylor(f(x), x, 0)"
                                          ToolTip="Polinomio de Taylor alrededor de un punto. Ejemplo: eˣ ≈ 1 + x + x²/2 + …"/>
                                <MenuItem Header="── Álgebra ──" IsEnabled="False"/>
                                <MenuItem Header="Simplificar" Click="Button_Click"
                                          Tag="%' Simplificar f(x) = (x²−1)/(x−1):§syms x§f(x) = (x^2 - 1)/(x - 1)§s = simplify(f(x))"
                                          ToolTip="Simplifica una expresión. Ejemplo: (x²−1)/(x−1) = x+1."/>
                                <MenuItem Header="Expandir" Click="Button_Click"
                                          Tag="%' Expandir f(x) = (x + 1)³:§syms x§f(x) = (x + 1)^3§e = expand(f(x))"
                                          ToolTip="Desarrolla productos y potencias. Ejemplo: (x+1)³ = x³+3x²+3x+1."/>
                                <MenuItem Header="Factorizar" Click="Button_Click"
                                          Tag="%' Factorizar f(x) = x²−1:§syms x§f(x) = x^2 - 1§fa = factor(f(x))"
                                          ToolTip="Factoriza. Ejemplo: x²−1 = (x−1)(x+1)."/>
                                <MenuItem Header="Resolver ecuación  (solve)" Click="Button_Click"
                                          Tag="%' Resolver f(x) = 0 con f(x) = x² − 4:§syms x§f(x) = x^2 - 4§sol = solve(f(x) == 0, x)"
                                          ToolTip="Resuelve simbólicamente. Ejemplo: x²−4 = 0 → x = 2, −2 (exacto)."/>
                                <MenuItem Header="Sustituir valor  (subs)" Click="Button_Click"
                                          Tag="%' Sustituir x = 3 en f(x) = x²:§syms x§f(x) = x^2§v = subs(f(x), x, 3)"
                                          ToolTip="Reemplaza una variable por un valor o expresión. Ejemplo: x²|ₓ₌₃ = 9."/>
                                <MenuItem Header="── Vectorial / salida ──" IsEnabled="False"/>
                                <MenuItem Header="Jacobiano" Click="Button_Click"
                                          Tag="%' Jacobiano de F = [x·y, x + y] respecto a [x, y]:§syms x y§F = [x*y, x + y]§J = jacobian(F, [x, y])"
                                          ToolTip="Matriz de derivadas parciales de un vector de funciones. Ejemplo: J = [y x; 1 1]."/>
                                <MenuItem Header="Exportar a LaTeX" Click="Button_Click"
                                          Tag="%' Exportar f(x) = x² + 1 a código LaTeX:§syms x§f(x) = x^2 + 1§L = latex(f(x))"
                                          ToolTip="Convierte la expresión a código LaTeX para pegar en un documento. Ejemplo: x^{2}+1."/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
