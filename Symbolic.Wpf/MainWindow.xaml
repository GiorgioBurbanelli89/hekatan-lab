                             HorizontalAlignment="Left" 
                             VerticalAlignment="Top" 
                             Margin="156,106,0,0" 
                             Width="160" 
                             Height="Auto" 
                             MaxHeight="160"
                             Visibility="Hidden" 
                             IsTextSearchCaseSensitive="True" 
                             Tag="0" 
                             FontFamily="Consolas" 
                             FontSize="13" 
                             FontWeight="Normal"
                             Focusable="False"
                             BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"/>
                    <!-- ═══ Ventana-loop (Fase 1): notación matemática → MATLAB ═══
                         Aparece en el mismo slot del autocomplete al escribir .loop -->
                    <Border Grid.Row="0" x:Name="LoopBuilderPanel" Visibility="Collapsed"
                            PreviewKeyDown="LoopBuilder_KeyDown"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="156,106,0,0"
                            Width="330" CornerRadius="6" Padding="10"
                            Background="{DynamicResource ThemePanelBg}"
                            BorderBrush="{DynamicResource ThemeAccentGold}" BorderThickness="1.5">
                        <Border.Resources>
                            <!-- Casillas oscuras (no blancas) dentro del panel -->
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="{DynamicResource ThemeEditorBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorder}"/>
                                <Setter Property="CaretBrush" Value="{DynamicResource ThemeText}"/>
                                <Setter Property="Padding" Value="2,1"/>
                            </Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Background" Value="{DynamicResource ThemeButtonBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorder}"/>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <!-- Operador -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="LbSum" GroupName="LbOp" Content="∑ Suma" IsChecked="True"
                                             Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="0,0,10,0"
                                             Checked="LoopBuilder_OpChanged"/>
                                <RadioButton x:Name="LbProd" GroupName="LbOp" Content="∏ Producto"
                                             Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="0,0,10,0"
                                             Checked="LoopBuilder_OpChanged"/>
                                <RadioButton x:Name="LbInt" GroupName="LbOp" Content="∫ Integral"
                                             Foreground="{DynamicResource ThemeText}" FontSize="13"
                                             Checked="LoopBuilder_OpChanged"/>
                            </StackPanel>
                            <!-- Notación matemática: símbolo grande + casillas -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <Grid VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="LbTo" Grid.Row="0" Text="10" Width="46" FontSize="12"
                                             HorizontalContentAlignment="Center" HorizontalAlignment="Center"
                                             TextChanged="LoopBuilder_InputChanged"
                                             ToolTip="Límite superior"/>
                                    <TextBlock x:Name="LbSymbol" Grid.Row="1" Text="∑" FontSize="40" FontFamily="Cambria Math, Cambria"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource ThemeAccentGold}"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBox x:Name="LbVar" Text="k" Width="26" FontSize="12"
                                                 HorizontalContentAlignment="Center" TextChanged="LoopBuilder_InputChanged"
                                                 ToolTip="Variable / índice"/>
                                        <TextBlock x:Name="LbEq" Text=" = " FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ThemeText}"/>
                                        <TextBox x:Name="LbFrom" Text="1" Width="30" FontSize="12"
                                                 HorizontalContentAlignment="Center" TextChanged="LoopBuilder_InputChanged"
                                                 ToolTip="Límite inferior"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="LbExpr" Text="k" MinWidth="150" FontSize="14" VerticalAlignment="Center"
